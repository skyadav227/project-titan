# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local: mongodb://localhost:27017/titan
# Atlas: mongodb+srv://user:password@cluster.mongodb.net/titan
MONGO_URI=mongodb://localhost:27017/titan

# ── Auth ──────────────────────────────────────────────────────────────────────
# Use a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ── File Storage ──────────────────────────────────────────────────────────────
# Directory where uploaded resume files are stored (relative to server root)
# Must NOT be inside a publicly served folder
UPLOAD_DIR=uploads

# ── AI Provider ───────────────────────────────────────────────────────────────
# Provider adapter to use — currently only "openrouter" is supported
AI_PROVIDER=openrouter

# OpenRouter model to use for resume analysis + interview intelligence
# Change this to switch models without touching application code
# Free Models Router — dynamically selects an available free model.
# This avoids depending on a specific free model slug that may be
# deprecated or removed from OpenRouter.
AI_MODEL=openrouter/free

# OpenRouter API key — NEVER expose this to the frontend
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Your site URL (sent as HTTP-Referer to OpenRouter)
APP_URL=http://localhost:5173

# ── Speech / STT Provider ─────────────────────────────────────────────────────
# Provider adapter for speech-to-text transcription.
# Supported values: "openai" | "local_whisper" | "dev_echo"
#   local_whisper: requires Python 3.8+ and faster-whisper installed in the
#     Python environment. Run: pip install faster-whisper
#     Use SPEECH_PYTHON_PATH and SPEECH_SCRIPT_PATH overrides if needed.
#   dev_echo: no-op dev fallback only — always returns an empty transcript.
#   openai: uses the OpenAI Whisper API; requires OPENAI_API_KEY below.
# In production set to "openai" and provide OPENAI_API_KEY below.
SPEECH_PROVIDER=local_whisper

# Optional: override the Python interpreter used by local_whisper
# SPEECH_PYTHON_PATH=python

# Optional: override the path to the transcription script used by local_whisper
# SPEECH_SCRIPT_PATH=src/services/speech/transcribe.py

# OpenAI API key — required when SPEECH_PROVIDER=openai
# Used ONLY for Whisper transcription — never sent to the client
OPENAI_API_KEY=your_openai_api_key_here

# Whisper model to use (e.g. whisper-1)
SPEECH_MODEL=whisper-1

# ── Audio Upload ──────────────────────────────────────────────────────────────
# Maximum audio file size in megabytes (server-side hard limit)
MAX_AUDIO_SIZE_MB=25

# Accepted audio MIME types (comma-separated)
# These are validated server-side — never trust the client
AUDIO_ACCEPTED_MIMES=audio/webm,audio/ogg,audio/mp4,audio/mpeg,audio/wav,audio/x-wav

# ── Interview Intelligence ────────────────────────────────────────────────────
# Maximum retries allowed per question (candidates can retry up to this many times)
MAX_RETRIES_PER_QUESTION=2

# Maximum number of AI retries on transient generation failures
AI_MAX_RETRIES=3

# Comma-separated ordered list of model IDs for answer evaluation fallback.
# TITAN tries each model in order. On reasoning overflow, empty content, invalid
# JSON, schema mismatch, rate limit, or provider error, the next model is tried.
# On network error, the same model is retried once before advancing.
# AI_CONFIG_ERROR and AI_AUTH_ERROR abort the entire sequence immediately.
#
# REQUIRED BEFORE USE: Manually test each candidate model with a real TITAN
# evaluation prompt to confirm it returns valid JSON without reasoning overflow.
# Leave empty to use AI_MODEL with the existing retry behavior (safe default).
# DO NOT include openrouter/free — it may route back to a failed model.
#
# Example (do not copy without testing):
#   AI_EVAL_MODELS=google/gemma-4-31b-it:free,recursive/flint-v1.0:free
AI_EVAL_MODELS=

# AI operation timeout in milliseconds
AI_TIMEOUT_MS=30000

# Checkpoint reevaluation limit — extra bounded retry allowance per unresolved
# question at the final evaluation checkpoint. Independent of AI_MAX_RETRIES.
# When this limit is exhausted the user may permanently skip the question.
CHECKPOINT_REEVAL_LIMIT=2
