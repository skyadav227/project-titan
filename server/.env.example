# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local: mongodb://localhost:27017/titan
# Atlas: mongodb+srv://user:password@cluster.mongodb.net/titan
MONGO_URI=mongodb://localhost:27017/titan

# ── Auth ──────────────────────────────────────────────────────────────────────
# Use a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ── File Storage ──────────────────────────────────────────────────────────────
# Directory where uploaded resume files are stored (relative to server root)
# Must NOT be inside a publicly served folder
UPLOAD_DIR=uploads

# ── AI Provider ───────────────────────────────────────────────────────────────
# Provider adapter to use — currently only "openrouter" is supported
AI_PROVIDER=openrouter

# OpenRouter model to use for resume analysis + interview intelligence
# Change this to switch models without touching application code
# Example free models (check openrouter.ai/models for current availability):
#   meta-llama/llama-3.1-8b-instruct:free
#   mistralai/mistral-7b-instruct:free
AI_MODEL=meta-llama/llama-3.1-8b-instruct:free

# OpenRouter API key — NEVER expose this to the frontend
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Your site URL (sent as HTTP-Referer to OpenRouter)
APP_URL=http://localhost:5173

# ── Speech / STT Provider ─────────────────────────────────────────────────────
# Provider adapter for speech-to-text transcription.
# Supported values: "openai" | "dev_echo" (dev_echo is a no-op dev fallback only)
# In production set to "openai" and provide OPENAI_API_KEY below.
SPEECH_PROVIDER=dev_echo

# OpenAI API key — required when SPEECH_PROVIDER=openai
# Used ONLY for Whisper transcription — never sent to the client
OPENAI_API_KEY=your_openai_api_key_here

# Whisper model to use (e.g. whisper-1)
SPEECH_MODEL=whisper-1

# ── Audio Upload ──────────────────────────────────────────────────────────────
# Maximum audio file size in megabytes (server-side hard limit)
MAX_AUDIO_SIZE_MB=25

# Accepted audio MIME types (comma-separated)
# These are validated server-side — never trust the client
AUDIO_ACCEPTED_MIMES=audio/webm,audio/ogg,audio/mp4,audio/mpeg,audio/wav,audio/x-wav

# ── Interview Intelligence ────────────────────────────────────────────────────
# Maximum retries allowed per question (candidates can retry up to this many times)
MAX_RETRIES_PER_QUESTION=2

# Maximum number of AI retries on transient generation failures
AI_MAX_RETRIES=3

# AI operation timeout in milliseconds
AI_TIMEOUT_MS=30000
